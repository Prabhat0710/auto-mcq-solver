{
  "manifest_version": 3,
  "name": "Auto MCQ Solver",
  "version": "1.1.0",
  "description": "Automatically answers MCQ questions using AI. Extracts video context and solves quizzes.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.workers.dev/*",
    "https://*.pages.dev/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.guvi.in/*",
        "https://*.moodle.org/*",
        "https://*.moodle.com/*",
        "https://*.instructure.com/*",
        "https://*.coursera.org/*",
        "https://*.edx.org/*",
        "https://docs.google.com/forms/*",
        "https://*.blackboard.com/*",
        "https://*.brightspace.com/*",
        "https://*.d2l.com/*",
        "https://*.udemy.com/*",
        "https://*.skillsync.com/*",
        "https://*.forms.office.com/*",
        "https://*.hackerrank.com/*",
        "https://*.hackerearth.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
